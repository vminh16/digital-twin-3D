+        max_steps=30_000 if stage == "confirm" else 7_000,
+        stop_step=stop_step,
+        checkpoint_every=3_000,
+        rolling_checkpoint=stage == "confirm",
+    )
+
+    assert run_training.preserve_confirmation_snapshot(args) is None
+    assert not (output / "snapshots").exists()
